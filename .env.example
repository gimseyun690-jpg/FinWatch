POSTGRES_DB=finwatch
POSTGRES_USER=finwatch
POSTGRES_PASSWORD=finwatch-local

DB_URL=jdbc:postgresql://localhost:5432/finwatch
DB_USERNAME=finwatch
DB_PASSWORD=finwatch-local
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=
JWT_ISSUER=finwatch-api
JWT_ACCESS_TOKEN_TTL=1h
DEMO_USERS_ENABLED=true
DEMO_USER_PASSWORD=FinWatch123!
DEMO_ADMIN_PASSWORD=FinWatchAdmin123!

AI_PROVIDER=mock
AI_ALLOWED_PROMPT_VERSIONS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_CONNECT_TIMEOUT=3s
GEMINI_READ_TIMEOUT=15s
AI_INPUT_PRICE_PER_MILLION=0.25
AI_OUTPUT_PRICE_PER_MILLION=1.50

DATA_MODE=DEMO
DATA_CONNECT_TIMEOUT=3s
DATA_READ_TIMEOUT=10s
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_HTS_ID=
KIS_ENV=paper
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1

# SEC EDGAR 등 자동 접근 정책이 요구하는 프로젝트명과 연락처를 설정합니다.
ARTICLE_USER_AGENT=
ARTICLE_CONNECT_TIMEOUT=2s
ARTICLE_READ_TIMEOUT=5s
ARTICLE_MAX_RESPONSE_BYTES=1048576
ARTICLE_MAX_REDIRECTS=3
OPENDART_API_KEY=
IR_RSS_POLICY_ENABLED=false

# 공식 IR/RSS 출처는 이용 조건과 robots 정책을 검토한 뒤 Spring 설정의
# app.news-content.configured-policies에 host/path/reviewReference/reviewedAt을 등록하세요.
OPENDART_MAX_ARCHIVE_ENTRIES=50
OPENDART_MAX_UNCOMPRESSED_BYTES=4194304
